# 数据库：本地 Docker Compose 默认值
DATABASE_URL=postgresql+psycopg://durableflow:durableflow@localhost:5432/durableflow
REDIS_URL=redis://localhost:6379/0

# API 鉴权：留空表示开发环境不校验
API_KEY=

# LLM：默认 mock，不花钱；接真实模型时改成 openai
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_INPUT_PRICE_PER_1M=2.0
LLM_OUTPUT_PRICE_PER_1M=8.0

# Worker
WORKER_ID=worker-1
WORKER_CONCURRENCY=2
LEASE_SECONDS=30
HEARTBEAT_SECONDS=10
REAPER_INTERVAL_SECONDS=15
POLL_INTERVAL_SECONDS=1.0

# 上下文压缩（估算 token）
CONTEXT_MAX_TOKENS=4000
CONTEXT_KEEP_LAST_MESSAGES=6

# 限流
RATE_LIMIT_PER_MINUTE=120

# 观测
LOG_LEVEL=INFO
OTEL_ENABLED=false
